<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission android:name="com.myenvironment.chimediscoverbridge.CONNECT"
        android:protectionLevel="signature" />
    <queries>
        <package android:name="com.myenvironment.launcher" />
        <package android:name="com.google.android.googlequicksearchbox" />
    </queries>
    <application android:label="@string/app_name" android:icon="@drawable/ic_companion" android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".CompanionActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".DiscoverBridgeService" android:exported="true"
            android:permission="com.myenvironment.chimediscoverbridge.CONNECT" />
    </application>
</manifest>
